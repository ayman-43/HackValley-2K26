{
  "name": "Nagrik Roads Bengaluru",
  "short_name": "Nagrik Roads",
  "description": "Report potholes and scan roads. Damage is pinned on Bengaluru's ward map and routed to the responsible officer.",
  "start_url": "/roads/app",
  "scope": "/roads/",
  "display": "standalone",
  "background_color": "#f1f3f5",
  "theme_color": "#f1f3f5",
  "icons": [
    { "src": "/roads/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/roads/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "/roads/assets/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Report a pothole", "url": "/roads/app" },
    { "name": "Scan while driving", "url": "/roads/live.html" }
  ]
}
