# Copy this file to backend/.env and fill it in. backend/.env is git-ignored: never commit it.

# MongoDB for accounts and sign-in sessions (MongoDB Atlas: Connect > Drivers > copy the connection string).
# Leave empty to keep using the local SQLite database.
ROADSENSE_MONGO_URI=
# Database name (optional; default: the one in the URI, else nagrik_roads)
ROADSENSE_MONGO_DB=nagrik_roads

# Google sign-in: OAuth 2.0 Client ID of type "Web application" from https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origins: http://localhost:5501 and http://localhost:8000 (plus your real domain later)
ROADSENSE_GOOGLE_CLIENT_ID=

# Google emails that become administrators the first time they sign in (comma separated)
ROADSENSE_ADMIN_EMAILS=

# Supabase Auth instead of the direct Google button: Project URL and the PUBLISHABLE key (never the secret key)
ROADSENSE_SUPABASE_URL=
ROADSENSE_SUPABASE_KEY=
